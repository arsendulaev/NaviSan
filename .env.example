# Скопируй этот файл в .env и заполни значения.
# НЕ коммить .env в git.

# Telegram Bot token от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой Telegram user ID (узнать через @userinfobot)
NAVISAN_OWNER_ID=

# Пути к директориям (абсолютные или относительные от корня проекта)
NAVISAN_INBOX=/inbox
NAVISAN_STAGING=/staging
NAVISAN_LIBRARY=/library

# Путь к базе данных Navidrome (read-only внутри Docker: /data/navidrome.db)
NAVISAN_DB=/data/navidrome.db

# Опционально: OAuth-токен аккаунта Яндекс Музыки (для поиска обложек через Yandex Music API).
# Если сервер в РФ / СНГ, поиск обложек в Яндексе работает и без токена.
# Если сервер за рубежом (или через зарубежный VPN), токен необходим для обхода гео-блокировки (451).
# Получить токен можно по ссылке:
# https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_MUSIC_TOKEN=
